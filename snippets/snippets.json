{
    "start/end": {
        "prefix": "aastart",
        "body": [
            ";\tdb\t\"start---\"",
            ";\tdb\t\"---end\""
        ],
        "description": ""
    },
    "msg": {
        "prefix": "msg",
        "body": [
            "cmp\twpmsg,WM_${1:message}",
            "jne\tnot${2:label1}",
            "$0",
            "not${3:label2}:"
        ],
        "description": "msg"
    },
    "": {
        "prefix": "invokecall",
        "body": [
            "invokecall\t"
        ],
        "description": ""
    },
    "x32 MessageBox": {
        "prefix": "aaMB",
        "body": [
            "invokecall\tMessageBox,0,os $1,esp,0$0"
        ],
        "description": "Fast MessageBox x32"
    },
    "SendMessage": {
        "prefix": "aaMes",
        "body": [
            "invokecall\tSendMessage,wphwnd,WM_$1,wpw,wpl$0"
        ],
        "description": "Fast SendMessage"
    },
    "ShellExecute": {
        "prefix": "aaExe",
        "body": [
            "invokecall\tShellExecute,0,0,os $1,0,0,SW_SHOWNORMAL$0"
        ],
        "description": "Fast ShellExecute"
    },
    "SaveAs": {
        "prefix": "aaSave",
        "body": [
            "invokecall\tsaveAs,${1:from},${2:size}$0"
        ],
        "description": "Fast saveAs"
    },
    "Label": {
        "prefix": "oo",
        "body": [
            "ooooooooooooooooo:"
        ],
        "description": "Fast label"
    },
    "Separator": {
        "prefix": "aaSep",
        "body": [
            ";------------------------------------------------------------------"
        ],
        "description": "Fast separator"
    }
}
