{
	"name": "asm Shark",
	"patterns": [
		{	"include": "#asmos"		},
		{	"include": "#xymm"		},
		{	"include": "#jumps"		},
		{	"include": "#fnames"		},
		{	"include": "#strong"		},
		{	"include": "#stuff"		},
		{	"include": "#call"		},
		{	"include": "#invoke3"		},
		{	"include": "#invoke2"		},
		{	"include": "#invoke"		},
		{	"include": "#constant"		},
		{	"include": "#string"		},
		{	"include": "#labels"		},
		{	"include": "#Comment1"		},
		{	"include": "#keyword"		},
		{	"include": "#comment2"		},
		{	"include": "#brackets"		}		
	],
	"repository": {
		"fnames": {
			"patterns": [
				{
					"name": "fnames.asm entity.name.function",
					"match": "(?<=call\\d*\\s)\\w*(?=,|\\s)"
				},
				{
					"name": "xymm.asm strong.asm entity.name.function",
					"match": "(?i)\\b[xy]mm([0-9]|1[0-5])\\b"
				}
			]
		},
		"jumps": {
			"patterns": [
				{
					"match": "\\b((?i)(jecxz|jcxz|jmp|jb|jc|jnae|jae|jnb|jnc|je|jz|jne|jnz|jbe|jna|ja|jnbe|jl|jnge|jge|jnl|jle|jng|jg|jnle))\\b(?:\\s+([a-zA-Z_@$?.][\\w@$?.]*))?",
					"captures": {
						"1": {
							"name": "jumps.asm strong.asm storage"
						},
						"3": {
							"name": "labels.asm entity.name.function"
						}
					}
				}
			]
		},
		"asmos": {
			"patterns": [
				{
					"match": "\\b((?i)(os))\\b(?:\\s+([a-zA-Z_@$?.][\\w@$?.]*))?",
					"captures": {
						"1": {
							"name": "asmos.asm strong.asm storage"
						},
						"3": {
							"name": "labels.asm entity.name.function"
						}
					}
				},
				{
					"name": "asmos.asm strong.asm storage",
					"match": "\\b((?i)(bpt|wpt|dpt|qpt|ypt|xpt|fpt|tpt|opt|proc|endp|invoke))\\b"
				}
			]
		},
		"strong": {
			"patterns": [
				{
					"name": "defblack.asm strong.asm",
					"match": "\\b((?i)(or|dup|stdcall|ret|endm|macro|local|label|equ|du|dd|db|dw|dq|al|ah|ax|eax|rax|bl|bh|bx|ebx|rbx|cl|ch|cx|ecx|rcx|dl|dh|dx|edx|rdx|bp|ebp|rbp|sp|esp|rsp|si|esi|rsi|di|edi|rdi|r([89]|1[0-5])[dwb]?|cs|ds|es|fs|gs|ss|dr[0-7]))\\b"
				}
			]
		},
		"stuff": {
			"patterns": [
				{
					"name": "stuff.asm strong.asm markup.changed",
					"match": "\\w+_\\w*"
				}
			]
		},
		"call": {
			"patterns": [
				{
					"name": "call.asm strong.asm entity.name",
					"match": "\\bcall"
				}
			]
		},
		"invoke3": {
			"patterns": [
				{
					"name": "invoke3.asm strong.asm storage",
					"match": "\\binvokecall3"
				}
			]
		},
		"invoke2": {
			"patterns": [
				{
					"name": "invoke2.asm strong.asm entity.name",
					"match": "\\binvokecall2"
				}
			]
		},
		"invoke": {
			"patterns": [
				{
					"name": "call.asm entity.name",
					"match": "\\binvokecall"
				}
			]
		},
		"constant": {
			"patterns": [
				{
					"name": "constant.language.asm string.regexp",
					"match": "\\.((?i)(386|386P|387|486|486p|586|586p|686|686p|k3d|mmx|xmm))\\b"
				},
				{
					"name": "constant.numeric.asm",
					"match": "([0-9]|0[a-fA-F])[0-9a-fA-F]{0,19}+([hH]|\\b)"
				}
			]
		},
		"Comment1": {
			"patterns": [
				{
					"name": "Comment1.asm storage strong.asm",
					"match": ";;.*$"
				}
			]
		},
		"keyword": {
			"patterns": [
				{
					"name": "keyword.asm keyword.control.asm",
					"match": "\\b((?i)(elseif2|elseif|else|endif|endw|ifndef|ifdef|ifidn|ifdif|ifnb|ifb|ife|if2|if|forc|for|goto|repeat|while|irp|rept))\\b"
				},
				{
					"name": "keyword.asm keyword.control.asm",
					"match": "\\.((?i)(elseif|else|endif|endw|errndef|erridn|errdif|errdef|errnb|errnz|errb|erre|err2|err|if|while|repeat|untilcxz|until|break|continue))\\b"
				},
				{
					"name": "keyword.asm strong.asm storage.type.asm",
					"match": "(\\.((?i)(fardata|data))\\?)|(\\.((?i)(allocstack|endprolog|pushframe|pushreg|savereg|savexmm128|setframe|listmacroall|listmacro|listall|listif|list|nolistmacro|nolistif|nolist|nocref|cref|xlist|tfcond|safeseh|startup|dosseg|fardata|alpha|model|stack|radix|const|code|data|exit|fpo|seq))\\b)"
				},
				{
					"name": "stuff.asm storage.type.asm",
					"match": "(@((?i)(fardata))\\?)|(@((?i)(interface|filename|codesize|datasize|wordsize|environ|version|filecur|catstr|sizestr|substr|curseg|fardata|instr|model|stack|date|time|code|data|cpu|line))\\b)"
				},
				{
					"name": "keyword.asm storage.type.asm",
					"match": "\\b((?i)(popcontext|pushcontext|includelib|externdef|subtitle|textequ|comment|include|typedef|assume|extern|option|public|record|segment|struct|title|union|alias|endp|endm|ends|exitm|group|page|proc|proto|purge|comm|echo|end))\\b"
				}
			]
		},
		"labels": {
			"patterns": [
			{
				"name": "fnames.asm entity.name.function",
				"match": "^@@\\w+:"
			},
			{
				"name": "fnames.asm entity.name.function",
				"match": "^\\w+:"
			},
			{
				"name": "fnames.asm entity.name.function",
				"match": "^\\w+(?=\\s+(?:proc|label|struct|endp)\\b)"
			}
			]
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.asm constant",
					"match": "[\"'].*?[';\"]"
				}
			]
		},
		"comment2": {
			"patterns": [
				{
					"name": "comment2.asm markup.ignored",
					"match": ";.*$"
				}
			]
		},
		"brackets": {
			"patterns": [
				{
					"begin": "\\[",
					"end": "\\]",
					"contentName": "fnames.asm entity.name.function",
					"patterns": [
						{ "include": "#asmos" },
						{ "include": "#strong" },
						{ "include": "#xymm" },
						{ "include": "#constant" }
					]
				}
			]
		}
	},
	"scopeName": "source.asm"
}